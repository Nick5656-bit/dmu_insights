# Local shared environment for Prisma and Next.js
# Copy to `.env` for local development. Never commit real secrets.

# Required: Neon / PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Required: secret used to sign session JWTs
# Generate one locally with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: public base URL used in links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required in production: used by Vercel Cron to authorize scheduled sends.
CRON_SECRET="replace-with-a-separate-long-random-secret"

# Required for Brevo transactional email delivery
BREVO_API_KEY="replace-with-brevo-api-key"
SMTP_FROM="DMU Feedback <no-reply@example.com>"

# Required before public launch: the contact address shown in the privacy notice.
PRIVACY_CONTACT_EMAIL="privacy-contact@example.com"
