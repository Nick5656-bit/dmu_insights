# ─── Database ────────────────────────────────────────────────────────────────
# MySQL-forbindelsesstreng til din webhosting.dk-database.
# Format: mysql://BRUGER:ADGANGSKODE@HOST:PORT/DATABASENAVN
# Eksempel: mysql://dmu_user:hemlig123@mysql.webhosting.dk:3306/dmu_survey
DATABASE_URL="mysql://BRUGER:ADGANGSKODE@HOST:3306/DATABASENAVN"

# ─── Session ──────────────────────────────────────────────────────────────────
# En lang, tilfældig streng der bruges til at signere login-sessioner (JWT).
# VIGTIGT: Skal udskiftes med en ny hemmelig streng før go-live!
# Generer en ny med: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="INDSAET_EN_LANG_TILFAELDIG_STRENG_HER"

# ─── App URL ──────────────────────────────────────────────────────────────────
# Den fulde URL til appen (uden trailing slash).
# Bruges i e-mail-links til survey-invitationer.
# Eksempel: https://dmu-survey.vercel.app  eller  https://ditdomaene.dk
NEXT_PUBLIC_APP_URL="https://DIT_DOMÆNE_HER"

# ─── E-mail (SMTP via webhosting.dk) ─────────────────────────────────────────
# Udfyldes når e-mail-funktionen implementeres.
# Find disse oplysninger i dit webhosting.dk kontrolpanel.
SMTP_HOST="smtpmax.webhosting.dk"
SMTP_PORT="587"
SMTP_USER="din-email@ditdomaene.dk"
SMTP_PASS="DIN_EMAIL_ADGANGSKODE"
SMTP_FROM="DMU Feedback <din-email@ditdomaene.dk>"
