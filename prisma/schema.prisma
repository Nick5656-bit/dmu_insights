// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DMU_ADMIN
  CLUB_ADMIN
}

enum AgeGroup {
  UNDER_18
  AGE_18_30
  AGE_31_50
  AGE_51_PLUS
}

enum RaceClass {
  MOTOCROSS
  ENDURO
  SPEEDWAY
  TRIAL
}

enum MemberRole {
  RIDER
  VOLUNTEER
}

// Segmentværdier gemmes på den enkelte besvarelse. De er adskilt fra
// medlemsoplysningerne, så et svar aldrig afhænger af en administrativ profil.
enum RespondentAgeGroup {
  UNDER_18
  AGE_18_30
  AGE_31_50
  AGE_51_PLUS
  PREFER_NOT_TO_SAY
  NOT_REPORTED
}

enum RespondentRole {
  RIDER
  SIDECAR_PASSENGER
  VOLUNTEER
  PARENT_GUARDIAN
  COACH_OFFICIAL
  OTHER
  PREFER_NOT_TO_SAY
  NOT_REPORTED
}

enum MotocrossClass {
  MICRO_BEGINNER_LOW_EFFECT
  MICRO_50
  MICRO_C_65
  MICRO_B_65
  MINI_C_65
  MINI_B_65
  MINI_C_85
  MINI_B_85
  PIGE
  PIGE_C
  C_125
  C_MX2
  C_MX1
  C_MAXI_MIX
  JUNIOR_125
  B_MX2
  B_MX1
  B_MAXI_MIX
  A_MX2
  A_MX1
  A_MAXI_MIX
  A_B_MAXI_MIX
  A_B_C_MAXI_MIX
  DAME
  DAME_C_CUP
  OLD_BOYS_C_30
  OLD_BOYS_B_30
  OLD_BOYS_A_30
  OLD_BOYS_B_40
  OLD_BOYS_A_40
  VETERAN_55
  CLASSIC_PRE_74_UNDER_66
  CLASSIC_PRE_74_66_PLUS
  CLASSIC_PRE_74_72_PLUS
  CLASSIC_TWIN_SHOCK_UNDER_60
  CLASSIC_TWIN_SHOCK_60_PLUS
  CLASSIC_125_TWIN_SHOCK
  CLASSIC_125_EVO_PRE_96
  CLASSIC_EVO_PRE_08_UNDER_50
  CLASSIC_EVO_PRE_08_50_PLUS
  CLASSIC_EVO_PRE_96_40_PLUS
  CLASSIC_EVO_PRE_96_60_PLUS
  CLASSIC_50CC_PRE_83
  CLASSIC_A
  PITBIKE_OPEN
  PITBIKE_STANDARD_OPEN
  SIDEVOGN_OPEN
  QUAD_BEGINNER_50
  QUAD_MICRO_100
  QUAD_MINI_100_VARIO
  QUAD_MINI_B_C_250_GEAR_MIX_OPEN
  QUAD_MAXI_C_450_500_OPEN
  QUAD_MAXI_A_B_500_OPEN
  QUAD_OLD_BOYS_40_OPEN
  NO_FIXED_CLASS
  PREFER_NOT_TO_SAY
  NOT_APPLICABLE
  NOT_REPORTED
}

enum QuestionType {
  SCALE_1_5
  SINGLE_CHOICE
  TEXT
}

enum QuestionScope {
  DMU_STANDARD
  CLUB_CUSTOM
}

enum SurveyType {
  ANNUAL
  EVENT
}

enum SurveyStatus {
  DRAFT
  SCHEDULED
  SENT
  CLOSED
}

enum SurveyInstanceQuestionSource {
  CORE
  CLUB_ADDED
}

enum ScheduledSendStatus {
  PENDING
  PROCESSED
}

enum ScheduledSendTriggerType {
  MANUAL
  EVENT_PLUS_1_DAY
}

enum InvitationStatus {
  CREATED
  SENT
  OPENED
  ANSWERED
}

enum InvitationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum ReminderStatus {
  NOT_SCHEDULED
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

enum MailStatus {
  SENT
  FAILED
}

enum SystemJobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  clubId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club                  Club?            @relation(fields: [clubId], references: [id])
  createdSurveyInstance SurveyInstance[] @relation("SurveyInstanceCreatedBy")
  createdEvents         Event[]
}

model Club {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  members         Member[]
  createdQuestions Question[]       @relation("QuestionCreatedByClub")
  surveyInstances SurveyInstance[]
  events          Event[]
  surveyResponses SurveyResponse[]
  extraEmails     ClubExtraEmail[]
}

model ClubExtraEmail {
  id        String   @id @default(cuid())
  clubId    String
  email     String
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, email])
}

model Member {
  id         String     @id @default(cuid())
  clubId     String
  name       String
  email      String     @unique
  ageGroup   AgeGroup
  raceClass  RaceClass
  memberRole MemberRole
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  club              Club               @relation(fields: [clubId], references: [id])
  surveyInvitations SurveyInvitation[]
}

model Question {
  id              String        @id @default(cuid())
  title           String
  description     String?
  questionType    QuestionType
  scope           QuestionScope
  benchmarkKey    String?
  createdByClubId String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdByClub      Club?                    @relation("QuestionCreatedByClub", fields: [createdByClubId], references: [id])
  options            QuestionOption[]
  templateQuestions  SurveyTemplateQuestion[]
  instanceQuestions  SurveyInstanceQuestion[]
  answers            SurveyAnswer[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  value      String
  sortOrder  Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, value])
}

model SurveyTemplate {
  id          String     @id @default(cuid())
  name        String
  surveyType  SurveyType
  description String
  layoutJson  Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  templateQuestions SurveyTemplateQuestion[]
  surveyInstances   SurveyInstance[]
}

model SurveyTemplateQuestion {
  id                      String  @id @default(cuid())
  surveyTemplateId        String
  questionId              String
  sortOrder               Int
  required                Boolean @default(true)
  isCoreBenchmarkQuestion Boolean @default(false)

  surveyTemplate SurveyTemplate @relation(fields: [surveyTemplateId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([surveyTemplateId, questionId])
}

model SurveyInstance {
  id              String       @id @default(cuid())
  surveyTemplateId String
  clubId          String
  name            String
  surveyType      SurveyType
  status          SurveyStatus @default(DRAFT)
  eventId         String?
  createdByUserId String
  clubReadyAt     DateTime?
  clubReadyByUserId String?
  sentAt          DateTime?
  closesAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  surveyTemplate        SurveyTemplate          @relation(fields: [surveyTemplateId], references: [id])
  club                  Club                    @relation(fields: [clubId], references: [id])
  event                 Event?                  @relation(fields: [eventId], references: [id])
  createdByUser         User                    @relation("SurveyInstanceCreatedBy", fields: [createdByUserId], references: [id])
  surveyInstanceQuestions SurveyInstanceQuestion[]
  scheduledSends        ScheduledSend[]
  invitations           SurveyInvitation[]
  responses             SurveyResponse[]
}

model SurveyInstanceQuestion {
  id               String                      @id @default(cuid())
  surveyInstanceId String
  questionId       String
  sortOrder        Int
  required         Boolean                     @default(true)
  sourceType       SurveyInstanceQuestionSource

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([surveyInstanceId, questionId])
}

model Event {
  id              String   @id @default(cuid())
  clubId          String
  title           String
  eventDate       DateTime
  location        String
  eventType       String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  club            Club             @relation(fields: [clubId], references: [id])
  createdByUser   User             @relation(fields: [createdByUserId], references: [id])
  participants    EventParticipant[]
  surveyInstances SurveyInstance[]
}

model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  email     String
  name      String?
  createdAt DateTime @default(now())

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  surveyInvitations SurveyInvitation[]

  @@unique([eventId, email])
}

model ScheduledSend {
  id               String                   @id @default(cuid())
  surveyInstanceId String
  sendAt           DateTime
  status           ScheduledSendStatus      @default(PENDING)
  triggerType      ScheduledSendTriggerType
  processedAt      DateTime?
  processingStartedAt DateTime?

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
}

model SurveyInvitation {
  id               String           @id @default(cuid())
  surveyInstanceId String
  memberId         String?
  eventParticipantId String?
  emailSnapshot    String
  token            String           @unique
  tokenCiphertext  String?
  status           InvitationStatus @default(CREATED)
  deliveryStatus   InvitationDeliveryStatus @default(PENDING)
  deliveryAttempts Int              @default(0)
  lastDeliveryAttemptAt DateTime?
  nextDeliveryAttemptAt DateTime?
  lastDeliveryError String?
  reminderStatus   ReminderStatus @default(NOT_SCHEDULED)
  reminderScheduledAt DateTime?
  reminderSentAt   DateTime?
  reminderAttempts Int            @default(0)
  reminderLastAttemptAt DateTime?
  reminderNextAttemptAt DateTime?
  reminderLastError String?
  sentAt           DateTime?
  openedAt         DateTime?
  answeredAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id], onDelete: Cascade)
  member         Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  eventParticipant EventParticipant? @relation(fields: [eventParticipantId], references: [id], onDelete: SetNull)
  mailLogs       MailLog[]

  @@index([deliveryStatus, nextDeliveryAttemptAt])
  @@index([reminderStatus, reminderNextAttemptAt])
}

model SurveyResponse {
  id                 String         @id @default(cuid())
  surveyInstanceId   String
  clubId             String
  submittedAt        DateTime       @default(now())
  // Historiske snapshots beholdes, men bruges ikke længere til segmentering.
  ageGroup           AgeGroup?
  raceClass          RaceClass?
  memberRole         MemberRole?
  respondentAgeGroup RespondentAgeGroup @default(NOT_REPORTED)
  respondentRole     RespondentRole @default(NOT_REPORTED)
  motocrossClass     MotocrossClass @default(NOT_REPORTED)

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id], onDelete: Cascade)
  club           Club           @relation(fields: [clubId], references: [id])
  answers        SurveyAnswer[]

  @@index([clubId, respondentAgeGroup])
  @@index([clubId, respondentRole])
  @@index([clubId, motocrossClass])
}

model SurveyAnswer {
  id               String  @id @default(cuid())
  surveyResponseId String
  questionId       String
  numericValue     Int?
  optionValue      String?
  textValue        String?

  surveyResponse SurveyResponse @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model MailLog {
  id                 String     @id @default(cuid())
  surveyInvitationId String
  toEmail            String
  subject            String
  bodyPreview        String
  sentAt             DateTime
  status             MailStatus

  surveyInvitation SurveyInvitation @relation(fields: [surveyInvitationId], references: [id], onDelete: Cascade)
}

model SystemJobRun {
  id           String             @id @default(cuid())
  jobName      String
  status       SystemJobRunStatus @default(RUNNING)
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  summary      Json?
  errorMessage String?

  @@index([jobName, startedAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
